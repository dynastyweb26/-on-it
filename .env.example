# ── Supabase (project: bitfmmffnigxjjyxoxfr) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://bitfmmffnigxjjyxoxfr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SERVER ONLY. Never expose.

# ── Anthropic (Claude Haiku 4.5 for field extraction) ────────
ANTHROPIC_API_KEY=your_rotated_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── AssemblyAI (voice input) ─────────────────────────────────
ASSEMBLYAI_API_KEY=your_key_here

# ── EmailJS (client-side send — public by design) ────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_mov6wn1
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_ukaqa74
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# ── Zelle column encryption (server-side only, never in client bundle) ──
ZELLE_ENC_KEY=generate_a_long_random_string_here

# ── Upstash Redis (rate limiting on paid-API routes) ─────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

# ── Stripe (paywall — $9.99/mo, 1-month free trial) ──────────
# Add all four in Vercel with BOTH Production + Preview scope. Use TEST keys
# now (sk_test_/pk_test_); swap in live keys same-slot at launch — code paths
# don't change. Routes stay dormant (503) until STRIPE_SECRET_KEY is present.
# Secret key — Stripe Dashboard → Developers → API keys (server only).
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
# Webhook signing secret — Dashboard → Developers → Webhooks → your endpoint
# (/api/webhooks/stripe) → "Signing secret". Verifies the raw request body.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Price id for the $9.99/mo recurring product (30-day trial set in code) —
# Dashboard → Products → your price → "Price ID".
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id_here
# Publishable key (client-safe). Not required for hosted-Checkout redirect,
# included for future Stripe.js/Elements use — Dashboard → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# ── Web Push (2-day payment follow-ups) ──────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=generate_a_long_random_string_here
