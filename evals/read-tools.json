    { "id": "invoices-by-client", "request": "invoices for Ruth", "expect": { "tools": ["list_invoices"], "args": { "client": "Ruth" }, "templateId": "list.ranked", "writes": 0 } },
    { "id": "invoices-date-range", "request": "invoices from October 2026", "expect": { "tools": ["list_invoices"], "templateId": "list.ranked", "writes": 0 } },
    { "id": "invoices-unknown-status", "request": "show invoices that are banana", "expect": { "tools": ["list_invoices"], "templateId": "list.ranked", "writes": 0 } }
  ]
