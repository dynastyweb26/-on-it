    {
      "id": "record-payment-repeat-ask",
      "request": "Ruth paid me $25 for a car wash",
      "expect": {
        "writes": 0
      },
      "expectedFail": true,
      "reason": "The old /api/parse record-payment flow appends 'Did someone pay you? Name the client and how much...' to every reply instead of asking once (PUNCH-LIST, Chat record-payment)."
    },
    {
      "id": "record-payment-amount-in-words",
      "request": "Ruth paid me $25 for a car wash",
      "expect": {
        "writes": 0
      },
      "expectedFail": true,
      "reason": "The old /api/parse early return lets the model state the amount as words ('Ruth paid you 25') with no dollar sign; the money guard does not cover that path (PUNCH-LIST, TOOL-AUDIT F1)."
    },
    {
      "id": "record-payment-card-empty-after-zelle",
      "request": "Ruth $25 for carwash",
      "followUp": "Zelle",
      "expect": {
        "writes": 0
      },
      "expectedFail": true,
      "reason": "After 'Ruth $25 for carwash' then 'Zelle', the old flow opens the card with Client empty and Amount 0.00: the parsed fields never carry the earlier turn's client and amount into the proposal (PUNCH-LIST)."
    },
